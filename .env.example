# Zetaris
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
# Zetaris UI login. Basic auth for /redoc/docs.yaml. Not the API key.
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Where the Zetaris query engine (in Docker) reaches Postgres. Empty means
# host.docker.internal and the port in DATABASE_URL.
ZETARIS_PG_HOST=
ZETARIS_PG_PORT=
# Meterless Nightshift
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
# Routing modes, not model ids. The Sibyl fleet in Nightshift (NIGHT -> LANES)
# decides which Nemotron model serves each mode. Empty means the default shown.
METERLESS_MODEL_FAST=meterless/fast
METERLESS_MODEL_DEEP=meterless/deep
METERLESS_MODEL_CRITIC=meterless/fusion
METERLESS_MODEL_JUDGE=meterless/fusion
# Completion cap on every lane. Reasoning models return nothing at 512.
METERLESS_MAX_TOKENS=8192
# App
DATABASE_URL=postgresql://sibyl:sibyl@localhost:5434/sibyl
SAMPLE_MODE=true
# Committed Acme sample. The full download is data/sample/snapshots/ and is not in git.
SNAPSHOT_DIR=data/sample/snapshot-subset
RUN_MAX_SECONDS=600
RUN_MAX_TOKENS=400000
# false for the no-critic ablation in eval/collect_runs.py
CRITIC_ENABLED=true
# The API's scheduler polls repositories, refreshes feeds and runs interval triages.
# false stops the clock only; queued jobs (a run someone started) still run.
SIBYL_SCHEDULER=true
CONTACT_EMAIL=            # for API User-Agent headers
# Connected git repositories are cloned here.
REPOS_DIR=var/repos
# Empty means npx --yes @cyclonedx/cdxgen@12.9.0
CDXGEN_CMD=
# Optional
NVD_API_KEY=
GITHUB_TOKEN=
DISABLE_SOURCES=          # e.g. euvd,nvd for outage tests
