{"resultsPerPage":2000,"startIndex":8000,"totalResults":32689,"format":"NVD_CVE","version":"2.0","timestamp":"2026-10-24T11:53:11.315","vulnerabilities":[{"cve":{"id":"CVE-2025-59681","sourceIdentifier":"cve@mitre.org","published":"2025-10-01T19:15:36.487","lastModified":"2026-10-12T15:10:00.207","vulnStatus":"Modified","cveTags":[],"descriptions":[{"lang":"en","value":"An issue was discovered in Django 4.2 before 4.2.25, 5.1 before 5.1.13, and 5.2 before 5.2.7. QuerySet.annotate(), QuerySet.alias(), QuerySet.aggregate(), and QuerySet.extra() are subject to SQL injection in column aliases, when using a suitably crafted dictionary, with dictionary expansion, as the **kwargs passed to these methods (on MySQL and MariaDB)."},{"lang":"es","value":"Se descubrió un problema en Django 4.2 anterior a 4.2.25, 5.1 anterior a 5.1.13 y 5.2 anterior a 5.2.7. QuerySet.annotate(), QuerySet.alias(), QuerySet.aggregate() y QuerySet.extra() están sujetos a inyección SQL en los alias de columna, al usar un diccionario adecuadamente diseñado, con expansión de diccionario, como los kwargs pasados a estos métodos (en MySQL y MariaDB)."}],"affected":[{"source":"cve@mitre.org","affectedData":[{"vendor":"djangoproject","product":"Django","defaultStatus":"unknown","versions":[{"version":"4.2","lessThan":"4.2.25","versionType":"custom","status":"affected"},{"version":"5.1","lessThan":"5.1.13","versionType":"custom","status":"affected"},{"version":"5.2","lessThan":"5.2.7","versionType":"custom","status":"affected"}]}]}],"metrics":{"cvssMetricV31":[{"source":"cve@mitre.org","type":"Secondary","cvssData":{"version":"3.1","vectorString":"CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:C/C:H/I:L/A:N","baseScore":7.1,"baseSeverity":"HIGH","attackVector":"NETWORK","attackComplexity":"HIGH","privilegesRequired":"LOW","userInteraction":"NONE","scope":"CHANGED","confidentialityImpact":"HIGH","integrityImpact":"LOW","availabilityImpact":"NONE"},"exploitabilityScore":1.8,"impactScore":4.7},{"source":"nvd@nist.gov","type"