{"ghsa_id":"GHSA-g4rg-993r-mgx7","cve_id":"CVE-2021-42740","url":"https://api.github.com/advisories/GHSA-g4rg-993r-mgx7","html_url":"https://github.com/advisories/GHSA-g4rg-993r-mgx7","summary":"Improper Neutralization of Special Elements used in a Command in Shell-quote","description":"The shell-quote package before 1.7.3 for Node.js allows command injection. An attacker can inject unescaped shell metacharacters through a regex designed to support Windows drive letters. If the output of this package is passed to a real shell as a quoted argument to a command with `exec()`, an attacker can inject arbitrary commands. This is because the Windows drive letter regex character class is `[A-z]` instead of the correct `[A-Za-z]`. Several shell metacharacters exist in the space between capital letter Z and lower case letter a, such as the backtick character.","type":"reviewed","severity":"critical","repository_advisory_url":null,"source_code_location":"https://github.com/ljharb/shell-quote","identifiers":[{"value":"GHSA-g4rg-993r-mgx7","type":"GHSA"},{"value":"CVE-2021-42740","type":"CVE"}],"references":["https://nvd.nist.gov/vuln/detail/CVE-2021-42740","https://www.npmjs.com/package/shell-quote","https://github.com/ljharb/shell-quote/commit/5799416ed454aa4ec9afafc895b4e31760ea1abe","https://github.com/ljharb/shell-quote/blob/master/CHANGELOG.md#173","https://github.com/advisories/GHSA-g4rg-993r-mgx7"],"published_at":"2022-05-24T19:18:27Z","updated_at":"2025-09-10T17:27:09Z","github_reviewed_at":"2022-06-21T20:08:10Z","nvd_published_at":"2021-10-21T15:15:00Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"npm","name":"shell-quote"},"vulnerable_version_range":">= 1.6.3, <= 1.7.2","first_patched_version":"1.7.3","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","score":9.8},"cvss_v4":{"vector_string":null,"score":0.0}},"cwes":[{"cwe_id":"CWE-77","name":"Improper Neutralization of Special E