{"ghsa_id":"GHSA-hgf8-39gv-g3f2","cve_id":"CVE-2025-66221","url":"https://api.github.com/advisories/GHSA-hgf8-39gv-g3f2","html_url":"https://github.com/advisories/GHSA-hgf8-39gv-g3f2","summary":"Werkzeug safe_join() allows Windows special device names","description":"Werkzeug's `safe_join` function allows path segments with Windows device names. On Windows, there are special device names such as `CON`, `AUX`, etc that are implicitly present and readable in every directory. `send_from_directory` uses `safe_join` to safely serve files at user-specified paths under a directory. If the application is running on Windows, and the requested path ends with a special device name, the file will be opened successfully, but reading will hang indefinitely.","type":"reviewed","severity":"medium","repository_advisory_url":"https://api.github.com/repos/pallets/werkzeug/security-advisories/GHSA-hgf8-39gv-g3f2","source_code_location":"https://github.com/pallets/werkzeug","identifiers":[{"value":"GHSA-hgf8-39gv-g3f2","type":"GHSA"},{"value":"CVE-2025-66221","type":"CVE"}],"references":["https://github.com/pallets/werkzeug/security/advisories/GHSA-hgf8-39gv-g3f2","https://nvd.nist.gov/vuln/detail/CVE-2025-66221","https://github.com/pallets/werkzeug/commit/4b833376a45c323a189cd11d2362bcffdb1c0c13","https://github.com/pallets/werkzeug/releases/tag/3.1.4","https://github.com/advisories/GHSA-hgf8-39gv-g3f2"],"published_at":"2025-12-02T00:27:38Z","updated_at":"2025-12-02T00:27:38Z","github_reviewed_at":"2025-12-02T00:27:38Z","nvd_published_at":"2025-11-29T03:16:00Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"pip","name":"werkzeug"},"vulnerable_version_range":"< 3.1.4","first_patched_version":"3.1.4","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":null,"score":0.0},"cvss_v4":{"vector_string":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N","score":6.3}},"cwes":[{"cwe_id":"CWE-67","name":"Improper Handling of Windows Device Names